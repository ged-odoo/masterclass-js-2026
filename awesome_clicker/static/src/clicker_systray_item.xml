<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.ClickerSystray">
        <div class="o_nav_entry">
            Clicks: <t t-out="this.counter()"/>
            <button class="btn btn-secondary" t-on-click="this.increment">
                <i class="oi oi-lg" data-icon="add"></i>
            </button>
            <button class="btn btn-secondary" t-on-click="this.openClientAction">
                Open
            </button>
            </div>
    </t>
</templates>